# Copy to .env and edit. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ecoleak
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ecoleak_test

# development | production
ENVIRONMENT=development

# Comma separated CORS allow-list (never "*" in production)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Upload / import limits
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=20000

# Rate limits (requests per minute)
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# Phase 2 mock-to-real swap gate.
#   true  -> Module P / reports use Phase 1 mock behavior (instant fallback).
#   false -> Module P pulls live F/G/J/L engine output.
USE_MOCK_DATA=true
# Optional: DSN the carbon engine reads (defaults to DATABASE_URL).
# ECOLEAK_SQL_DSN=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ecoleak

# Auth: "stub" (Phase 1) or "jwt" (Phase 2)
AUTH_MODE=stub
# Required for a runnable config. Placeholder values (e.g. "change-me", "dev-only")
# are rejected by Settings at startup even in development, so set a real value
# before starting the app. Leave blank only for local throwaway runs.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
